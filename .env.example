# Quiver runs on the Claude Agent SDK, which by default reuses your
# logged-in Claude Code CLI session — no API key needed.
#
# Only uncomment this to bypass the CLI login and use a direct
# Anthropic API key instead (optional).
# ANTHROPIC_API_KEY=

# Knowledge base directory (where profile and artifacts are stored).
# Default: ~/Documents/Work Research
# QUIVER_KNOWLEDGE_DIR=

# Profile filename inside the knowledge directory.
# Default: profile.md
# QUIVER_PROFILE_FILENAME=
